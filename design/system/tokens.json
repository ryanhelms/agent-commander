{
  "version": 1,
  "appearance": "black-glass",
  "units": "Layout, type sizes and radii are in macOS points. Colors are sRGB. Material entries describe roles.",
  "color": {
    "window": "#090A0D",
    "panel": "#14151A",
    "well": "#0B0C10",
    "border": "#383B44",
    "foreground": "#F5F5F9",
    "secondary": "#B7BAC6",
    "focus": "#B5D6FF",
    "working": "#A8E0C0",
    "attention": "#F1C587",
    "failure": "#EC9B92",
    "selection": "#283344",
    "onAccent": "#101825",
    "opaqueChrome": "#15161A",
    "opaqueOverlay": "#1A1D24",
    "strongBorder": "#A6A8B2",
    "strongSecondary": "#E3E5EC",
    "harness": {
      "claude": "#D97757",
      "codex": "#629FFF",
      "mcp": "#B596EF",
      "swatch": {
        "rose": "#FB7185", "lime": "#A3E635", "mint": "#4ADE80", "teal": "#2DD4BF",
        "cyan": "#22D3EE", "sky": "#38BDF8", "fuchsia": "#E879F9", "pink": "#F472B6",
        "ice": "#BAE6FD", "sage": "#BBF7D0", "blush": "#FBCFE8"
      }
    }
  },
  "material": {
    "navigation": {"native": "system regular glass", "opaqueFallback": "opaqueChrome"},
    "floatingControl": {"native": "system regular glass", "opaqueFallback": "opaqueOverlay"},
    "page": {"fill": "window"},
    "panel": {"fill": "panel"},
    "terminal": {"fill": "well"},
    "harnessConsole": {
      "headerBase": "#101116",
      "minimumAccentLuminance": 0.18,
      "outlineWidth": 1.5,
      "increasedContrastOutlineWidth": 2
    }
  },
  "type": {
    "title": {"face": "system", "size": 32, "weight": "semibold"},
    "section": {"face": "system", "size": 18, "weight": "semibold"},
    "body": {"face": "system", "size": 14, "weight": "regular"},
    "control": {"face": "system", "size": 13, "weight": "medium"},
    "ownership": {"face": "system", "size": 12, "weight": "semibold"},
    "caption": {"face": "system", "size": 11, "weight": "regular"},
    "terminal": {"face": "systemMonospaced", "size": 13, "weight": "regular"}
  },
  "space": [4, 8, 12, 16, 24, 32],
  "layout": {
    "toolbarHeight": 52,
    "railWidth": 54,
    "sidebarWidth": 204,
    "coordinatorFraction": 0.333333,
    "preferredMinimumCoordinatorWidth": 320,
    "dividerHitWidth": 8,
    "tileGap": 12,
    "preferredMinimumWallTileWidth": 300,
    "pipWidth": 350,
    "drawerWidth": 310,
    "minimumHandoffButtonHeight": 28
  },
  "radius": {"terminalTile": 13, "overlay": 17, "sidebar": 19},
  "state": {
    "task": ["working", "idle", "reviewing", "completed", "failed", "unknown"],
    "connection": ["live", "reconnecting", "disconnected", "unknown"],
    "attention": ["none", "question", "approval", "requiresUserAction"],
    "messageDelivery": ["accepted", "delivered", "resolved", "deliveryUnknown"],
    "inputHolderKind": ["coordinator", "parentWorker", "developer", "unknown"],
    "controlState": ["observing", "acquiring", "held", "releasing", "denied", "unknown"],
    "keyboardFocus": ["unfocused", "focused"]
  },
  "appearanceOverrides": {
    "reduceTransparency": {"navigationFill": "opaqueChrome", "overlayFill": "opaqueOverlay"},
    "increaseContrast": {"secondary": "strongSecondary", "border": "strongBorder", "focusRing": "double"},
    "reduceMotion": {"transition": "immediate or short crossfade"}
  }
}
